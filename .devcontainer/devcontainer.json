{
  "name": "boboddy",
  // Use a minimal devcontainers base image with a non-root user.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  // Install Bun to match the repo's packageManager version.
  "features": {
    "ghcr.io/devcontainers/features/bun:1": {
      "version": "1.3.12"
    }
  },
  // Install monorepo dependencies on first create.
  "onCreateCommand": "bun install --frozen-lockfile",
  // Run as the non-root user provided by the base image.
  "remoteUser": "vscode"
}
