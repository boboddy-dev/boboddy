AGENT_DEFAULT_MODEL=github-copilot/gpt-5-mini

# Override to point at a local server during development
BOBODDY_BASE_URL=http://localhost:3000

# CLI telemetry (optional; a silent no-op when unset). The CLI's own
# write-only PostHog project token — see the PostHog block in the repo root
# .env.example for what "write-only" means here. Distinct from
# POSTHOG_API_KEY/HOST (server) because the CLI ships as an OSS binary run on
# users' machines, not a server env this repo controls.
POSTHOG_CLI_KEY=
POSTHOG_CLI_HOST=https://us.i.posthog.com

# Set to 1 to opt out of CLI telemetry for a single invocation, without
# touching ~/.boboddy.json (see `boboddy telemetry disable` for a persistent
# opt-out).
BOBODDY_TELEMETRY_DISABLED=

# Set to 1 to print every telemetry payload to stderr, in addition to
# sending it.
BOBODDY_TELEMETRY_DEBUG=
