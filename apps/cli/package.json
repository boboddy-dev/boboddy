{
  "name": "@boboddy/cli",
  "version": "0.0.0",
  "bin": {
    "boboddy": "bin/boboddy"
  },
  "exports": {
    ".": "./src/index.ts",
    "./reporter-clack": "./src/lib/reporter-clack.ts",
    "./reporter-record": "./src/lib/reporter-record.ts",
    "./reporter-types": "./src/lib/reporter-types.ts"
  },
  "files": [
    "README.md",
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/boboddy-dev/boboddy"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "build:dev": "bun run script/build.ts --dev",
    "link": "bun run script/link.ts",
    "link:local": "bun run build && bun link --global .",
    "publish:package": "bun run script/publish.ts",
    "test": "bun test test",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@boboddy/observability": "workspace:*",
    "@boboddy/opencode-plugin": "workspace:*",
    "@boboddy/sdk": "workspace:*",
    "@boboddy/worker": "workspace:*",
    "@clack/prompts": "^1.0.0",
    "@devcontainers/cli": "0.86.0",
    "@opencode-ai/sdk": "1.18.11",
    "ajv": "^8.20.0",
    "better-auth": "^1.6.7",
    "dotenv": "^16.0.0",
    "picocolors": "^1.1.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "uuid": "^13.0.0",
    "yargs": "^17.7.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "bun-types": "^1.4.0"
  }
}
