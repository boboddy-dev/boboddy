{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun-types", "node"],
    "noEmit": true,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@boboddy/worker": ["../../packages/worker/src/index.ts"],
      "@boboddy/worker/*": ["../../packages/worker/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "script/**/*.ts",
    "test/**/*.ts",
    "../../packages/worker/src/types/process-off-fallback.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
