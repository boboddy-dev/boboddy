import { loadPushDefaults } from "@boboddy/sdk/defaults";
import { pushFromDirectory } from "@boboddy/sdk/push";

const dir = import.meta.dirname;
const defaults = await loadPushDefaults({ dir });

if (!defaults.accessToken) {
