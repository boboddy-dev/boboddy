import { z } from "zod";
import { defineStep, Features } from "@boboddy/sdk/definitions/steps";
import { pipeline } from "@boboddy/sdk/definitions/pipelines";

// Archetype C — read-only data / state investigation.
// investigate (no_workspace + data MCP) → gate. No repository is cloned, so
// there is no Docker and no devcontainer requirement.
// Replace the MCP server and the work-item field that scopes the queries.

export const investigateData = defineStep({
  key: "investigate-data",
  name: "Investigate Data",
  description: "Explain wrong, missing or stale data from read-only sources.",
  status: "active",
  executionMode: "no_workspace",

  mcpServers: {
    warehouse: {
      type: "remote",
      url: "https://mcp.internal.example/warehouse",
      enabled: true,
    },
  },

  agentPrompt: ({ input, env }) => `
Explain why the reported data is wrong, missing, or stale.

Scope every query to the affected account: ${input.accountRef}. If that is null
or empty, say so in your summary and state which records you looked at instead —
do not silently widen the search and do not guess a scope.

Query with the warehouse MCP tools; the read-only connection is
${env.READONLY_DB_URL}. Everything you touch is read-only: never attempt a write,
a migration, or a job trigger.

Separate what you suspect from what you know:

- \`suspectedRootCause\`: your best theory, in prose.
- \`identifiedRequiredChanges\`: true ONLY if you can name the specific change
  that fixes this — a code path, a job, a constraint, a config value. A plausible
  theory with no identified change is false.
- \`requiredChanges\`: if true, what to change and where. If false, the next
  concrete step to narrow it down.
- \`confidence\`: 0 = inferring from the report, 1 = you ran queries whose results
  admit only this explanation. Score low when unsure; that parks this for a human
  instead of sending a guess downstream.
- \`evidence\`: the queries you ran and their actual results, including the query
  text. Prose without queries is not evidence.
- \`scopeAssessment\`: whether the problem is isolated to the scope above or
  broader, and what you ran to decide. People act on this first, so be specific.
`,

  // Optional because a pipeline-level binding supplies it. A required field
  // would force a mapper entry, and the only way to write one replaces the
  // work-item binding with a pipeline-input binding that resolves to null.
  additionalInput: z.object({
    accountRef: z.string().nullable().optional(),
  }),

  result: z.object({
    suspectedRootCause: z.string(),
    identifiedRequiredChanges: z.boolean(),
    requiredChanges: z.string(),
    confidence: z.number().min(0).max(1),
    evidence: z.array(z.string()),
    scopeAssessment: z.string(),
  }),

  signals: [
    { sourcePath: "suspectedRootCause" },
    { sourcePath: "identifiedRequiredChanges" },
    { sourcePath: "requiredChanges" },
    { sourcePath: "confidence" },
    { sourcePath: "scopeAssessment" },
  ],

  features: [Features.notifications()],
});

export default pipeline({
  key: "data-investigation",
  name: "Data Investigation",
  description: "Investigate a data problem against read-only sources.",
  status: "active",
  additionalPipelineInput: {
    schema: z.object({ accountRef: z.string().nullable() }),
    bindings: ({ workItem }) => ({ accountRef: workItem.field("Account") }),
  },
})
  .step(investigateData, () => ({}))
  // To hand the fix off instead of finishing here, replace "complete" with
  // route("failing-test-repro") — that pipeline must already exist on the
  // server or be in the same push batch.
  .advance(({ stepSignals, all }) => ({
    default: "block",
    rules: [
      all(
        stepSignals.confidence.gte(0.8),
        stepSignals.identifiedRequiredChanges.eq(true),
      ).then("complete"),
    ],
  }))
  .build();
