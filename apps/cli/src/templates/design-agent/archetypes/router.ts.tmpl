import { z } from "zod";
import { defineStep, Features } from "@boboddy/sdk/definitions/steps";
import { definePipeline, Rule } from "@boboddy/sdk/definitions/pipelines";

// Archetype E — router in front of other pipelines.
// classify (no_workspace) → block unless confident → a `choice` state picks
// one of the target pipelines by `routeKey`.
//
// A `choice` branch can only target another state in THIS pipeline — it
// cannot reach a different pipeline directly (see §4 of the authoring
// reference). Routing to one of several pipelines therefore needs one tiny
// `dispatch` state per target, each doing no real work of its own; its only
// job is to carry that target's `next: { routeToPipeline: ... }`.
//
// ROUTE_KEYS must be the exact keys of pipelines that already exist on the
// server or are in the same push batch; push validates them and throws
// otherwise. A router with one target is pointless — build the target first.
const ROUTE_KEYS = [
  "browser-repro",
  "failing-test-repro",
  "data-investigation",
] as const;

export const classifyWorkItem = defineStep({
  key: "classify-work-item",
  name: "Classify Work Item",
  description: "Choose which pipeline should handle this work item.",
  status: "active",
  executionMode: "no_workspace",

  agentPrompt: `
Choose exactly one pipeline to handle this work item, using only its title and
description. Do not investigate; you are dispatching, not solving.

Pick \`routeKey\` from these values and only these:

- \`browser-repro\` — a user-visible failure in the running application: a page, a
  form, a flow, something visibly wrong in the UI.
- \`failing-test-repro\` — a defect in code with no user-facing surface: an API
  returning the wrong shape, a library, a CLI, a background job crashing.
- \`data-investigation\` — the code may be fine but a value is wrong, missing, or
  stale: a report showing the wrong number, a record that did not sync.

If you are torn between two and one is \`failing-test-repro\`, choose
\`failing-test-repro\`; it needs nothing but the repository, so a missing
environment cannot block it. If it fits none of them, still pick your best guess,
set \`confidence\` low, and explain in \`reasoning\` — a low score parks the item for
a human rather than sending it down the wrong pipeline.

\`confidence\`: 0 = you could not tell what kind of problem this is, 1 = the report
names the surface unambiguously.

\`reasoning\`: one or two sentences a human can check without rereading the
report. Name the words in the report that decided it.
`,

  result: z.object({
    routeKey: z.enum(ROUTE_KEYS),
    confidence: z.number().min(0).max(1),
    reasoning: z.string(),
  }),

  signals: [
    { sourcePath: "routeKey" },
    { sourcePath: "confidence" },
    { sourcePath: "reasoning" },
  ],

  features: [Features.notifications()],
});

// The forwarder used by every `toX` dispatch state below. It does no real
// work — it exists only so each dispatch state has a `step` to carry its own
// `next: { routeToPipeline }` — so it stays `no_workspace` and asks nothing
// of the model.
export const dispatch = defineStep({
  key: "dispatch",
  name: "Dispatch",
  description: "No-op forwarder: exists only to carry a route target.",
  status: "active",
  executionMode: "no_workspace",
  agentPrompt: "Acknowledge the routing decision. No action is required.",
});

export default definePipeline({
  key: "work-item-router",
  name: "Work Item Router",
  description: "Classify an incoming work item and route it to a pipeline.",
  status: "active",
  startAt: "classify",
  states: {
    classify: {
      kind: "step",
      step: classifyWorkItem,
      input: () => ({}),
      // Block on low confidence rather than picking a lane at random.
      blockWhen: Rule.when("confidence", "lessThan", 0.7),
      next: "chooseRoute",
    },
    chooseRoute: {
      kind: "choice",
      choices: [
        {
          when: Rule.when("routeKey", "equal", "browser-repro"),
          next: "toBrowserRepro",
        },
        {
          when: Rule.when("routeKey", "equal", "failing-test-repro"),
          next: "toFailingTestRepro",
        },
      ],
      // `routeKey` is a 3-value enum; the third value falls through here
      // rather than needing its own redundant `choices[]` entry.
      default: "toDataInvestigation",
    },
    toBrowserRepro: {
      kind: "step",
      step: dispatch,
      input: () => ({}),
      next: { routeToPipeline: "browser-repro" },
    },
    toFailingTestRepro: {
      kind: "step",
      step: dispatch,
      input: () => ({}),
      next: { routeToPipeline: "failing-test-repro" },
    },
    toDataInvestigation: {
      kind: "step",
      step: dispatch,
      input: () => ({}),
      next: { routeToPipeline: "data-investigation" },
    },
  },
});
