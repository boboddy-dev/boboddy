{
  "name": "@boboddy/observability",
  "private": true,
  "type": "module",
  "exports": {
    "./analytics/browser": {
      "types": "./src/analytics/browser.ts",
      "bun": "./src/analytics/browser.ts",
      "default": "./src/analytics/browser.ts"
    },
    "./analytics/server": {
      "types": "./src/analytics/server.ts",
      "bun": "./src/analytics/server.ts",
      "default": "./src/analytics/server.ts"
    },
    "./analytics/events": {
      "types": "./src/analytics/events.ts",
      "bun": "./src/analytics/events.ts",
      "default": "./src/analytics/events.ts"
    },
    "./analytics/test-mocks/*": {
      "types": "./src/analytics/test-mocks/*.ts",
      "bun": "./src/analytics/test-mocks/*.ts",
      "default": "./src/analytics/test-mocks/*.ts"
    },
    "./logging": {
      "types": "./src/logging/index.ts",
      "bun": "./src/logging/index.ts",
      "default": "./src/logging/index.ts"
    },
    "./logging/host": {
      "types": "./src/logging/host.ts",
      "bun": "./src/logging/host.ts",
      "default": "./src/logging/host.ts"
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json --noEmit",
    "declarations": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "pino": "^9.14.0",
    "posthog-js": "^1.376.1",
    "posthog-node": "^4.18.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.12"
  }
}
