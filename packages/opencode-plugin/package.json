{
  "name": "@boboddy/opencode-plugin",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/plugin.js"
    }
  },
  "main": "./dist/plugin.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/plugin.ts --bundle --outfile dist/plugin.js --target bun --external @opencode/plugin",
    "declarations": "bun run build && find dist -name '*.d.ts' -delete 2>/dev/null; bunx tsgo -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@boboddy/sdk": "workspace:*",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.28"
  },
  "devDependencies": {
    "@opencode/client": "2.0.28",
    "@opencode/plugin": "2.0.28",
    "bun-types": "^1.4.0"
  }
}
